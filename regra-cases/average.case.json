{
  "project": "regra",
  "entry": "average",
  "title": "An empty list has an average of zero",
  "repro": {
    "name": "Empty input returns zero",
    "args": [
      []
    ],
    "expect": 0
  },
  "checks": [
    {
      "name": "Positive numbers",
      "args": [
        [
          2,
          4,
          6
        ]
      ],
      "expect": 4
    },
    {
      "name": "A single number",
      "args": [
        [
          7
        ]
      ],
      "expect": 7
    },
    {
      "name": "Negative numbers",
      "args": [
        [
          -8,
          -4
        ]
      ],
      "expect": -6
    },
    {
      "name": "Zero is a valid value",
      "args": [
        [
          0,
          0
        ]
      ],
      "expect": 0
    }
  ]
}
